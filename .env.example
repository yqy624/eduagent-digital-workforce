# ============================================================
# EduAgent · 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 只有 .env.example 会进仓库，.env 永远不入库。
# ============================================================

# === 应用 ===
APP_ENV=development
LOG_LEVEL=INFO
SERVER_HOST=0.0.0.0
# 教育段端口（与同机其他服务错开，见 docs/03-开发指南/启动指南.md）
SERVER_PORT=18010
CORS_ORIGINS=http://localhost:18010,http://127.0.0.1:18010

# === 数据库 ===
# mysql：生产形态，需要本机或容器内有 MySQL
# sqlite：零依赖演示模式，开箱即用（推荐第一次跑用这个）
DB_BACKEND=sqlite
SQLITE_PATH=data/platform.db

DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_db
DB_USERNAME=root
DB_PASSWORD=change-me

# === Redis（可选，未配置时退化进程内实现） ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# === 认证 ===
JWT_SECRET=ChangeThisJwtSecretBeforeProductionUse_AtLeast32CharsLong
JWT_EXPIRATION=86400000

# === 对象存储（可选） ===
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=education-files

# === 本地文件存储 ===
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# === AI 总开关与向量库 ===
# 置为 false 时全部 AI 入口走规则降级，界面照常可用（离线演示用）
AI_ENABLED=true
VECTOR_STORE=faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=data/chroma

# === Agent 运行时 ===
AGENT_MEMORY_LOAD_LIMIT=8
AGENT_MEMORY_PROMPT_LIMIT=6
AGENT_EXECUTION_CONTEXT_CHARS=16000

# === 大模型（至少配一个；都空则走降级） ===
# 任意 OpenAI 兼容网关：BASE_URL 要带 /v1 后缀
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# 网关掉线时不要死等：读取超时（秒）+ 最大重试次数（连接超时固定 5s）
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=1

# Ollama（本地跑模型时填；MODEL 留空表示不启用，避免抢占 OPENAI 通道）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-max

# === 模型层实现选择（切换真实模型只改这里，业务代码不动） ===
# placeholder | yolo-platform | http-yolo
MODEL_VISION_BACKEND=placeholder
# placeholder | ollama | openai
MODEL_LLM_BACKEND=placeholder
# placeholder | hf | ollama
MODEL_EMBEDDING_BACKEND=placeholder

# === 视觉推理（YOLO） ===
# 常驻 HTTP 推理服务（模型只加载一次，推荐）
VISION_SERVICE_URL=http://127.0.0.1:18030
VISION_WEIGHTS=yolo11n.pt
# 子进程模式：指向视觉平台仓库目录（本机绝对路径或相对路径均可）
YOLO_PLATFORM_DIR=../yolo-platform
YOLO_PLATFORM_PYTHON=.venv/Scripts/python.exe

# === 检索层：知识库外置（rag-go） ===
# local=进程内 FAISS/词法实现；http-rag=外置给 rag-go
RAG_BACKEND=local
RAG_SERVICE_URL=http://127.0.0.1:18000
RAG_SERVICE_TIMEOUT_MS=15000
RAG_LIBRARY_PREFIX=course_
# 入库方式：multipart=直接上传字节（无需对象存储）；from-object=走 MinIO
RAG_INGEST_MODE=multipart
RAG_INGEST_ENABLED=true
# 外置检索失败时是否回落本地实现（生产建议 true）
RAG_FALLBACK_TO_LOCAL=true
